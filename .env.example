# SMTP2GO — used by /api/contact via nodemailer
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=2525
SMTP_USER=your-smtp2go-username
SMTP_PASS=your-smtp2go-password

# Official sender (must be allowed in SMTP2GO) and inbox for form submissions.
CONTACT_FROM_EMAIL=info@risepower.com
CONTACT_TO_EMAIL=info@risepower.com
